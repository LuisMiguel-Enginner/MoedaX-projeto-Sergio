{
  "info": {
    "name": "MoedaX API",
    "description": "Coleção de testes da API MoedaX (HTTP Basic Auth + CRUD + mercado).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "adminEmail", "value": "admin@moedax.local" },
    { "key": "adminPassword", "value": "admin123" },
    { "key": "investorEmail", "value": "investidor@moedax.local" },
    { "key": "investorPassword", "value": "invest123" },
    { "key": "assetId", "value": "1" },
    { "key": "quoteId", "value": "1" },
    { "key": "alertId", "value": "1" },
    { "key": "watchlistId", "value": "1" },
    { "key": "userId", "value": "2" }
  ],
  "item": [
    {
      "name": "Mercado (público)",
      "item": [
        {
          "name": "GET Assets (live)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/assets"
          }
        },
        {
          "name": "GET History BTC 24h",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/history?symbol=BTC&period=24h"
          }
        },
        {
          "name": "GET History símbolo inválido (400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/history?symbol=XYZ&period=24h"
          }
        },
        {
          "name": "GET Supabase Config",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/supabase-config"
          }
        }
      ]
    },
    {
      "name": "Autenticação",
      "item": [
        {
          "name": "GET Me (admin)",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{adminEmail}}" },
                { "key": "password", "value": "{{adminPassword}}" }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/me"
          }
        },
        {
          "name": "GET Me sem auth (401)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/me"
          }
        },
        {
          "name": "GET Users como investidor (403)",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{investorEmail}}" },
                { "key": "password", "value": "{{investorPassword}}" }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users"
          }
        }
      ]
    },
