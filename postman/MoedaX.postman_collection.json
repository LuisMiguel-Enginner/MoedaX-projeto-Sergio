          "name": "PUT User",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{adminEmail}}" },
                { "key": "password", "value": "{{adminPassword}}" }
              ]
            },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Investidor Atualizado\"\n}"
            },
            "url": "{{baseUrl}}/api/users/{{userId}}"
