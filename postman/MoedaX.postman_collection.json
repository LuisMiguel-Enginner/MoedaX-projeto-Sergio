                { "key": "password", "value": "{{adminPassword}}" }
              ]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"novo@moedax.local\",\n  \"password\": \"senha123\",\n  \"full_name\": \"Novo Usuário\",\n  \"role\": \"investidor\"\n}"
            },
            "url": "{{baseUrl}}/api/users"
